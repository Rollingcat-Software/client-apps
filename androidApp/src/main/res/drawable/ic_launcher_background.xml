<?xml version="1.0" encoding="utf-8"?>
<!--
  FIVUCSAS adaptive-icon background: full-bleed 108x108dp vector filled with a
  diagonal indigo -> purple linear gradient (#6366F1 -> #8B5CF6).
  The gradient is declared inline via aapt:attr so no extra color resources leak.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item
                    android:color="#6366F1"
                    android:offset="0.0" />
                <item
                    android:color="#8B5CF6"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
